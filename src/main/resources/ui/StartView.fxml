<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.StartViewController">
   <children>
      <Label text="Do Not Pass Go Banker">
         <font>
            <Font name="System Bold" size="50.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" prefHeight="40.0" spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleNewGame" text="New Game" />
            <Button mnemonicParsing="false" onAction="#handleLoadGame" text="Load Game" />
         </children>
      </HBox>
      <GridPane fx:id="newGameGrid" hgap="10.0" vgap="10.0" visible="false">
        <columnConstraints>
          <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label fx:id="firstPlayerLabel" text="1." GridPane.rowIndex="1" />
            <Label text="6." GridPane.rowIndex="6" />
            <Label text="5." GridPane.rowIndex="5" />
            <Label text="4." GridPane.rowIndex="4" />
            <Label text="3." GridPane.halignment="RIGHT" GridPane.rowIndex="3" />
            <Label fx:id="secondPlayerLabel" text="2." GridPane.rowIndex="2" />
            <Label text="Players (in correct order)" GridPane.columnIndex="1" />
            <TextField fx:id="firstPlayerField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="secondPlayerField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="thirdPlayerField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="fourthPlayerField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <TextField fx:id="fifthPlayerField" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <TextField fx:id="sixthPlayerField" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            <TextField fx:id="startingMoneyField" text="1500" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <TextField fx:id="passGoMoneyField" text="200" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            <ToggleButton fx:id="enableFreeParkingButton" mnemonicParsing="false" onAction="#handleFreeParkingButtonPressed" selected="true" text="Enabled" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            <Button mnemonicParsing="false" onAction="#handleStartNewGame" text="Start Game" GridPane.columnIndex="3" GridPane.halignment="RIGHT" GridPane.rowIndex="7" />
            <Label text="Starting Money" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Label text="Pass Go Money" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <Label text="Free Parking Cash" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <Pane prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="4" GridPane.rowIndex="4" />
            <Label fx:id="generalErrorLabel" alignment="TOP_RIGHT" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.halignment="RIGHT" GridPane.rowIndex="6" />
            <Label fx:id="startErrorLabel" GridPane.columnIndex="4" GridPane.rowIndex="1" />
            <Label fx:id="passGoErrorLabel" GridPane.columnIndex="4" GridPane.rowIndex="2" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </GridPane>
   </children>
